#include <iostream>
using namespace std;

void heapify(int a[], int n, int i)
{
    int smallest = i;
    int left = 2 * i + 1;
    int right = 2 * i + 2;

    if (left < n && a[left] < a[smallest])
        smallest = left;

    if (right < n && a[right] < a[smallest])
        smallest = right;

    if (smallest != i)
    {
        swap(a[i], a[smallest]);
        heapify(a, n, smallest);
    }
}

void minHeapSort(int a[], int n)
{
    // Build Min Heap
    for (int i = n / 2 - 1; i >= 0; i--)
        heapify(a, n, i);

    // Sorting
    for (int i = n - 1; i > 0; i--)
    {
        swap(a[0], a[i]);
        heapify(a, i, 0);
    }
}

int main()
{
    int a[] = {20, 10, 30, 5, 15};
    int n = 5;

    minHeapSort(a, n);

    cout << "Sorted array: ";

    for (int i = 0; i < n; i++)
        cout << a[i] << " ";

    return 0;
}
